# =============================================================================
# video-kb-pipeline — environment variables
# Copy this file to .env and fill in real values before running.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL (asyncpg format)
# Use the postgresql+asyncpg:// scheme — the settings layer strips it to
# postgresql:// automatically before handing it to asyncpg.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# -----------------------------------------------------------------------------
# Vector search: pgvector only (B7 — Pinecone dropped, no separate vector-
# database env vars needed). All embeddings live as Postgres columns with
# ivfflat indexes: searchable_facts.embedding, kg_nodes.embedding,
# scenes.embedding, storylines.embedding, stock_assets.embedding — all
# dim=1024 (BAAI/bge-large-en-v1.5), except keyframes.dino_embedding
# (dim=768) and persons.arcface_embedding (dim=512).
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible object storage)
# R2_ENDPOINT_URL format: https://<account-id>.r2.cloudflarestorage.com
# -----------------------------------------------------------------------------
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=video-kb-bucket

# -----------------------------------------------------------------------------
# Neo4j (Graph DB for knowledge graph traversal)
# Use bolt:// for local/self-hosted, neo4j+s:// for AuraDB (TLS).
# NEO4J_PASSWORD is required — no default.
# NEO4J_DATABASE defaults to "neo4j" (the default Neo4j database name).
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687        # or neo4j+s://xxxxx.databases.neo4j.io for AuraDB
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password    # REQUIRED
NEO4J_DATABASE=neo4j                  # default database name

# -----------------------------------------------------------------------------
# Local embedding model (sentence-transformers, runs on same GPU as Qwen)
# BAAI/bge-large-en-v1.5 produces 1024-dim vectors — no external API needed.
# The default below matches the hardcoded default in shared/config.py.
# Only change this if you want to swap in a different bge-* variant.
# EMBED_MODEL=BAAI/bge-large-en-v1.5

# -----------------------------------------------------------------------------
# OpenAI — OPTIONAL, NOT used for embeddings (local model used instead).
# Reserved for future use (e.g. GPT-4 tutor responses).
# Leave blank unless you have a specific use case that requires it.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# -----------------------------------------------------------------------------
# Hugging Face — required to download gated models (e.g. Qwen2.5-VL, and
# pyannote/speaker-diarization-3.1 + pyannote/segmentation-3.0 used by Level-2
# Stage 0 diarization). Accept both pyannote model licenses on huggingface.co
# with the account this token belongs to, or diarization will fail to load
# (non-fatal — L2 continues without speaker_turns).
# -----------------------------------------------------------------------------
HF_TOKEN=hf_...

# PYANNOTE_MODEL=pyannote/speaker-diarization-3.1   # default, override only if needed

# -----------------------------------------------------------------------------
# Modal — GPU serverless compute for heavy inference levels.
# Preferred setup: run `modal token set --token-id X --token-secret Y`
# which writes credentials to ~/.modal.toml (no env vars needed).
# Set these only if you prefer env-based auth over the CLI flow.
# -----------------------------------------------------------------------------
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# -----------------------------------------------------------------------------
# OpenRouter — L4-L6 reasoning/planning/agent calls (Grounding Agent, Story
# Architect Agent, L5 Selection + Sequencing, L6 Color/Caption/Compositing/QA
# agents). Real two-tier split via OpenRouter's Qwen lineup — see
# shared/llm_client.py and shared/config.py's per-stage *_MODEL settings.
# Cheap/fast tier: qwen/qwen3-30b-a3b-instruct-2507 ($0.04815/$0.1931 per M).
# Strong tier: qwen/qwen3-235b-a22b-2507 ($0.09/$0.55 per M).
# Optional: only needed when running L4/L5/L6.
# -----------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...
# L4 uses deepseek/deepseek-v3.2 for both tiers (was the Qwen split below) —
# see shared/config.py for the reasoning.enabled=True/False per-stage split.
# L4_GROUNDING_MODEL=deepseek/deepseek-v3.2
# L4_STORY_ARCHITECT_MODEL=deepseek/deepseek-v3.2
# L5_SELECTION_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# L5_SEQUENCING_MODEL=qwen/qwen3-235b-a22b-2507
# L6_CAPTION_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# L6_COLOR_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# L6_COMPOSITING_MODEL=qwen/qwen3-30b-a3b-instruct-2507
# L6_QA_MODEL=qwen/qwen3-235b-a22b-2507

# -----------------------------------------------------------------------------
# Groq — optional fallback provider, not used by default (see
# shared/llm_client.py's get_llm_client(prefer_groq=True)). Only needed if a
# specific call site opts into Groq's lower latency over OpenRouter.
# -----------------------------------------------------------------------------
# GROQ_API_KEY=gsk_...

# -----------------------------------------------------------------------------
# Stock asset library (A2 — knowledge_base/stock_assets/). Pexels API key,
# free tier: https://www.pexels.com/api/. Optional — leave blank if you only
# ever ingest "internal" curated-library assets (no API key needed for
# source='internal' rows); knowledge_base/stock_assets/client.py raises at
# call time (not at import) if a Pexels search is attempted without one.
# -----------------------------------------------------------------------------
PEXELS_API_KEY=
